# ── App Configuration ─────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=generate-a-random-64-char-string-for-jwt
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Transaction Pooler Connection (Port 6543):
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database Connection Pool & SSL Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_SSL_MODE=require

# ── Task Queue & Redis ───────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379/0

# ── AI Configuration (Google Gemini) ─────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_RESEARCH_STALE_RUNNING_MINUTES=10

# ── Signal Data Sources ──────────────────────────────────────
APOLLO_API_KEY=your-apollo-api-key
CRUNCHBASE_API_KEY=
BUILTITH_API_KEY=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
SERPAPI_KEY=

# ── HubSpot Integration ──────────────────────────────────────
HUBSPOT_APP_CLIENT_ID=your-hubspot-client-id
HUBSPOT_APP_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_WEBHOOK_SECRET=your-hubspot-webhook-secret
HUBSPOT_REDIRECT_URI=https://api.yourdomain.com/api/v1/integrations/hubspot/callback
HUBSPOT_HISTORICAL_DAYS=180
HUBSPOT_SYNC_INTERVAL_MINUTES=30
HUBSPOT_HISTORICAL_BATCH_SIZE=100
HUBSPOT_FUZZY_MATCH_THRESHOLD=85
# ── Salesforce Integration ────────────────────────────────────
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_REDIRECT_URI=https://api.yourdomain.com/api/v1/crm/salesforce/callback
SALESFORCE_SANDBOX=false
# ── Microsoft Dynamics 365 Integration ────────────────────────
DYNAMICS_CLIENT_ID=your-dynamics-client-id
DYNAMICS_CLIENT_SECRET=your-dynamics-client-secret
DYNAMICS_TENANT_ID=common
DYNAMICS_REDIRECT_URI=https://api.yourdomain.com/api/v1/crm/dynamics/callback
# ── Zoho CRM Integration ──────────────────────────────────────
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://api.yourdomain.com/api/v1/crm/zoho/callback
ZOHO_DATA_CENTER=com

# ── Security & Token Encryption ──────────────────────────────
# Fernet Key — Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key

# ── Integrations & Webhooks ──────────────────────────────────
INSTANTLY_API_KEY=
SLACK_WEBHOOK_URL=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
LOGFIRE_TOKEN=

# ── Rate Limits & Schedules ──────────────────────────────────
LLM_CACHE_TTL_HOURS=24
LLM_MAX_REQUESTS_PER_WORKSPACE_PER_HOUR=10
SIGNAL_COLLECTION_CRON=0 */6 * * *
SCORE_COMPUTATION_CRON=30 */6 * * *
FEED_GENERATION_CRON=0 2 * * *
MODEL_RECALIBRATION_CRON=0 2 * * 6
